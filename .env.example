# Copy this file to .env.local and put your real key there.
# .env.local is ignored by git, so the key never reaches GitHub.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here

# Optional: models (defaults shown)
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Optional: AI reply budget per server (defaults shown). Keeps the free tier under Google's limits.
# CHAT_MAX_PER_MINUTE=12
# CHAT_MAX_PER_HOUR=300
